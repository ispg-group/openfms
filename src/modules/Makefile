########################
# Machine dependencies #
########################
CONFIG = ../../CONFIGFMS
INCFLAGS = -I ..
SUFFIXES = .f90 .f .F90 .F
INTERFACES = ../fortran_interfaces.inc
MAKEFILE = Makefile

.PHONY: clean

# Stuff for compiling our code:
SOURCEFILES=$(foreach suffix,$(SUFFIXES),$(wildcard *$(suffix)))
OBJECTFILES=$(addsuffix .o,$(basename $(SOURCEFILES)))

all: $(OBJECTFILES)

# Pattern rules
%.o : %.f
	@echo "Compiling $<"
	@$(FC) $(FFLAGS) $(INCFLAGS) -c $<

%.o : %.F
	@echo "Compiling $<"
	@$(FC) $(FFLAGS) $(INCFLAGS) -c $<

%.o : %.f90
	@echo "Compiling $<"
	@$(FC) $(FFLAGS) $(INCFLAGS) -c $<

%.o : %.F90
	@echo "Compiling $<"
	@$(FC) $(FFLAGS) $(INCFLAGS) -c $<

$(OBJECTFILES): $(CONFIG) $(MAKEFILE)

clean:
	$(RM) *.mod *.o

######################################################
# Module dependencies ################################
######################################################
QuanticsModule.o: QuanticsModule.F90 GlobalModule.o
ifeq ($(ESP),quantics)
	$(FC) $(FFLAGS) $(INCFLAGS) -I$(QUANTICS_DIR)/object/x86_64/gfortran/include/ -c $<
else
	@$(FC) $(FFLAGS) $(INCFLAGS) -c $<
endif

# We add -std=legacy flag to remove compiler warnings generated by old F77 routines, e.g.
# Warning: Fortran 2018 deleted feature: DO termination statement which is not END DO or CONTINUE with label 120 at (1)
EispackModule.o: EispackModule.f
	@echo "Compiling $<"
ifeq ($(FCTYPE),gnu)
	@$(FC) $(FFLAGS) $(INCFLAGS) -std=legacy -c $<
else
	@$(FC) $(FFLAGS) $(INCFLAGS) -c $<
endif

RandomModule.o: RandomModule.f90 GlobalModule.o

InitialModule.o: InitialModule.f90 GlobalModule.o FMSModule.o SpawnModule.o \
	SamplingModule.o VerletModule.o QM_MM_Module.o \
	TrajectoryModule.o TrajectoryCalcsModule.o BundleModule.o

SamplingModule.o: SamplingModule.f90 GlobalModule.o FMSModule.o EispackModule.o \
	RandomModule.o QM_MM_Module.o TrajectoryModule.o BundleCalcsModule.o OverlapModule.o

ThermoModule.o: ThermoModule.f90 GlobalModule.o

ElecStrucModule.o: ElecStrucModule.f90 GlobalModule.o

ToyModelModule.o: ToyModelModule.f90 GlobalModule.o TrajectoryModule.o ElecStrucModule.o

ParticleModule.o: ParticleModule.f90 GlobalModule.o

TerachemModule.o: TerachemModule.F90 GlobalModule.o TrajectoryModule.o ElecStrucModule.o

TrajectoryModule.o: TrajectoryModule.f90 ParticleModule.o QM_MM_Module.o \
			ElecStrucModule.o GlobalModule.o

TrajectoryCalcsModule.o: TrajectoryCalcsModule.f90 TrajectoryModule.o \
			ParticleModule.o QM_MM_Module.o ElecStrucModule.o \
			GlobalModule.o SMDModule.o \
			TemplateModule.o TerachemModule.o ToyModelModule.o QuanticsModule.o

TrajectoryIOModule.o: TrajectoryIOModule.f90 TrajectoryModule.o TrajectoryCalcsModule.o \
			ParticleModule.o QM_MM_Module.o \
			ElecStrucModule.o GlobalModule.o

OverlapModule.o: OverlapModule.f90 GlobalModule.o \
		ParticleModule.o TrajectoryModule.o TrajectoryCalcsModule.o

BundleModule.o: BundleModule.f90 TrajectoryModule.o TrajectoryCalcsModule.o GlobalModule.o

BundleCalcsModule.o: BundleCalcsModule.f90 BundleModule.o OverlapModule.o EispackModule.o \
			TrajectoryModule.o TrajectoryCalcsModule.o GlobalModule.o

BundleIOModule.o: BundleIOModule.f90 BundleCalcsModule.o BundleModule.o \
			TrajectoryCalcsModule.o TrajectoryIOModule.o GlobalModule.o \
			SMDModule.o OverlapModule.o SpawnModule.o

SelectionModule.o: SelectionModule.f90 GlobalModule.o RandomModule.o OverlapModule.o	 \
                   TrajectoryModule.o BundleModule.o BundleCalcsModule.o

SpawnModule.o: SpawnModule.f90 GlobalModule.o SelectionModule.o FMSModule.o \
               TrajectoryModule.o TrajectoryCalcsModule.o TrajectoryIOModule.o \
	       BundleModule.o BundleCalcsModule.o OverlapModule.o VerletModule.o

QM_MM_Module.o: QM_MM_Module.f90 GlobalModule.o

FMSModule.o: FMSModule.f90 $(INTERFACES) GlobalModule.o \
		ParticleModule.o TrajectoryModule.o BundleModule.o

TemplateModule.o: TemplateModule.f90 GlobalModule.o ElecStrucModule.o

SMDModule.o: SMDModule.f90 GlobalModule.o TrajectoryModule.o

RattleModule.o: RattleModule.f90 GlobalModule.o TrajectoryModule.o TrajectoryCalcsModule.o

MinSearchModule.o: MinSearchModule.f90 GlobalModule.o ElecStrucModule.o \
			TrajectoryModule.o TrajectoryCalcsModule.o TrajectoryIOModule.o \
			RattleModule.o QM_MM_Module.o

RestartModule.o: RestartModule.f90 GlobalModule.o BundleModule.o

VerletModule.o: VerletModule.f90 GlobalModule.o TrajectoryModule.o TrajectoryCalcsModule.o \
		RattleModule.o

PropagationModule.o: PropagationModule.f90 GlobalModule.o VerletModule.o FMSModule.o EispackModule.o \
		TrajectoryModule.o TrajectoryCalcsModule.o RattleModule.o \
		BundleModule.o BundleCalcsModule.o SpawnModule.o OverlapModule.o
