Basic ESSAIMS test, going through a single spawning event
and subsequent selection.
&control
! Input for Izmaylov model
!------ Initialization -------!
 InitState=2
 InitialCond='NoSample'
 iRndSeed=57034456
!------ Simulation Properties -------!
 Model='TOY'		!to identify the potential used
 iMethod=3        ! Indicates Izmaylov model
 IzmOmegax=0.009557
 IzmOmegay=0.003515
 IzmXshift=20.07
 IzmYshift=0.0
 IzmDeltaE=0.01984
 IzmCoupC=0.0006127
 NumParticles=2
 NumStates=2		!number of electronic states
 zAllText=.false.
 NumInitBasis=1
!---- Stochastic Selection - ESSAIMS
 Stochastic = .true.
!-------- Integration and numerics --------!
 TimeStep=1.0		!timestep for integration
 SimulationTime=68.	!integration time
 StochasticThresh = 0.0015  ! Change the default value of 1e-10 to induce faster selection
 MinTimeStep=0.001
!-------- Spawning -------!
 MultiSpawn=1		!number of spawns per event
 MaxTraj=80		!max number of trajectories
 OMax=0.6
 SpawnCoupV=.false.
 CSThresh=0.0001
 
 PopToSpawn=0.001
 CoupTimeStep=0.250
/ !Atom type information below
  2 ! number of atom types
#Name  AtomicNum  AtomicWeight(amu) Width(1/bohr**2)
 QQ    1       0.0005485      0.004775
 PP    1       0.0005485      0.001675
