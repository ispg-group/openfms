&control
! Input for some model
!------ Initialization -------!
 InitState=1
 InitialCond='swarm'
 iRndSeed=7777777
 iRestart=1,
 ! Restart all trajectories
 iRestartTraj=1,2,3,4,5,6,7,8,9
!------ Simulation Properties -------!
 Model='TOY'		 ! to identify the potential used
 iMethod=4           ! Indicates GAIMS model
 Grsigma=8.0
 NumParticles=1
 NumStates=2		 ! number of electronic states
 NumSinglets=1
 NumTriplets=1
 zAllText=.true.     ! Output all text-based files
 NumInitBasis=3
!---- Stochastic Selection ----!
 Stochastic = .true.
 StochasticThresh=0.50
 StochasticSwiss = .false.
 StochasticOlap = .true.
!-------- Integration and numerics --------!
 TimeStep=0.413		    ! = 0.01 fs, timestep for integration
 !SimulationTime=68.00	!integration time
 SimulationTime=1600
 MinTimeStep=0.001
!-------- Spawning -------!
!MultiSpawn=1		!number of spawns per event
 MaxTraj=80		    !max number of trajectories
! OMax=0.6
 SpawnCoupV=.false.
! CSThresh=0.0000
 SOCThresh=0.d0
 PopToSpawn=0.000
!CoupTimeStep=0.250
!-------- Output -------!
 zAllText=.false.
 zXYZ=.true.
 zCoupFile=.true.
 zPotEnFile=.true.
 zSOME=.false.
 zSOCeff=.false.
/ !Atom type information below
  1 ! number of atom types
#Name  AtomicNum  AtomicWeight(amu) Width(1/bohr**2)
 F    1       10.9700000      20.000000
